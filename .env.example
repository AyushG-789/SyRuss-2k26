# Copy to .env (never commit .env)

# --- LLM (SPEC.md §6) ---
# Chatbot (Gemini) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest

OPENAI_API_KEY=
# mini-tier model for parsing / report extraction
OPENAI_MODEL_FAST=
# stronger model for route explanations
OPENAI_MODEL_SMART=

# --- Voice (SPEC.md §7) ---
# gemini (uses GEMINI_API_KEY) | sarvam (uses SARVAM_API_KEY)
VOICE_PROVIDER=gemini
SARVAM_API_KEY=

# --- Demo ---
# A Tuesday, so museums in the itinerary are open (Bhau Daji Lad closes Wed, SGNP/Elephanta Mon)
DEMO_DATE=2026-10-20
SCENARIO_FILE=scenarios/demo.json
# mock | live
NEWS_MODE=mock
OFFICIAL_MODE=mock
WEATHER_MODE=mock

# --- Live feeds (optional; ask the team for the shared keys, never commit them) ---
RAILRADAR_API_KEY=
TOMTOM_API_KEY=
NEWSAPI_KEY=
MAPBOX_TOKEN=
